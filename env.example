# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA coloque valores reais neste arquivo: ele vai para o GitHub.

# Banco de dados
# SQLite (desenvolvimento):
DATABASE_URL=sqlite:///./database.db
# PostgreSQL com psycopg 3 (quando migrar):
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nome_do_banco

# Chave usada para assinar os tokens JWT. Gere uma nova para cada ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-gerada

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Validade do access token, em minutos
ACCESS_TOKEN_TIME=30

# Validade do refresh token (ainda não usado no código; defina a unidade quando implementar)
REFRESH_TOKEN_TIME=7
